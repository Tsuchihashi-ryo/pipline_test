  "deploymentSpec": {
    "executors": {
      "exec-add": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "add"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.15.2' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef add(\n    num1: float,\n    num2: float,\n    sum_artifact: Output[Artifact],\n):\n    \"\"\"Adds two numbers and saves the result to an artifact.\"\"\"\n    total = num1 + num2\n    with open(sum_artifact.path, 'w') as f:\n        f.write(str(total))\n\n"
          ],
          "image": "gcr.io/YOUR_PROJECT_ID/pipeline-components:latest"
        }
      },
      "exec-difference": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "difference"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.15.2' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef difference(\n    num1_artifact: Input[Artifact],\n    num2_artifact: Input[Artifact],\n    difference_artifact: Output[Artifact],\n):\n    \"\"\"Calculates the difference between two numbers passed as artifacts.\"\"\"\n    with open(num1_artifact.path, 'r') as f:\n        num1 = float(f.read())\n    with open(num2_artifact.path, 'r') as f:\n        num2 = float(f.read())\n\n    diff = num1 - num2\n\n    with open(difference_artifact.path, 'w') as f:\n        f.write(str(diff))\n\n"
          ],
          "image": "gcr.io/YOUR_PROJECT_ID/pipeline-components:latest"
        }
      },
      "exec-multiply": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "multiply"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.15.2' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef multiply(\n    num1: float,\n    num2: float,\n    product_artifact: Output[Artifact],\n):\n    \"\"\"Multiplies two numbers and saves the result to an artifact.\"\"\"\n    product = num1 * num2\n    with open(product_artifact.path, 'w') as f:\n        f.write(str(product))\n\n"
          ],
          "image": "gcr.io/YOUR_PROJECT_ID/pipeline-components:latest"
        }
      },
      "exec-sigmoid": {
        "container": {
          "args": [
            "--executor_input",
            "{{$}}",
            "--function_to_execute",
            "sigmoid"
          ],
          "command": [
            "sh",
            "-c",
            "\nif ! [ -x \"$(command -v pip)\" ]; then\n    python3 -m ensurepip || python3 -m ensurepip --user || apt-get install python3-pip\nfi\n\nPIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-warn-script-location 'kfp==2.15.2' '--no-deps' 'typing-extensions>=3.7.4,<5; python_version<\"3.9\"' && \"$0\" \"$@\"\n",
            "sh",
            "-ec",
            "program_path=$(mktemp -d)\n\nprintf \"%s\" \"$0\" > \"$program_path/ephemeral_component.py\"\n_KFP_RUNTIME=true python3 -m kfp.dsl.executor_main                         --component_module_path                         \"$program_path/ephemeral_component.py\"                         \"$@\"\n",
            "\nimport kfp\nfrom kfp import dsl\nfrom kfp.dsl import *\nfrom typing import *\n\ndef sigmoid(\n    input_artifact: Input[Artifact],\n    output_artifact: Output[Artifact],\n):\n    \"\"\"\n    Applies the sigmoid function to a number from an artifact.\n    This component runs in a custom Docker container with scipy pre-installed.\n    \"\"\"\n    from scipy.special import expit\n\n    with open(input_artifact.path, 'r') as f:\n        value = float(f.read())\n\n    sigmoid_value = expit(value)\n\n    with open(output_artifact.path, 'w') as f:\n        f.write(str(sigmoid_value))\n\n"
          ],
          "image": "gcr.io/YOUR_PROJECT_ID/pipeline-components:latest"
        }
      }
    }
  },
